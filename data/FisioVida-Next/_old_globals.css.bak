:root{
  box-sizing:border-box;
  --teal-950:#0b2f31;
  --teal-900:#0e3a3c;
  --teal-800:#124749;
  --teal-700:#17595b;
  --teal-500:#189a8c;
  --teal-400:#1fb3a1;
  --teal-300:#5fcdbd;
  --teal-100:#e3f5f1;
  --teal-50:#f2faf8;

  --ink-900:#12201f;
  --ink-700:#3c4b4a;
  --ink-500:#6c7b7a;
  --ink-300:#a6b3b1;
  --line:#e3e9e7;
  --line-soft:#eef2f0;

  --bg:#f5f8f7;
  --surface:#ffffff;

  --green:#1c9a63; --green-bg:#e8f7ee;
  --red:#d64545; --red-bg:#fceaea;
  --amber:#c58a1f; --amber-bg:#fbf1de;
  --blue:#3672c9; --blue-bg:#e9f1fc;

  --radius-lg:18px;
  --radius-md:12px;
  --radius-sm:8px;
  --shadow-card:0 1px 2px rgba(15,40,38,.04), 0 8px 24px -12px rgba(15,40,38,.10);

  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0a1615; --surface:#0f1f1e; --line:#1e302e; --line-soft:#182524;
    --ink-900:#eef3f2; --ink-700:#c4d1cf; --ink-500:#8fa19e; --ink-300:#5c6b69;
    --teal-100:#123634; --teal-50:#0f2726;
  }
}
:root[data-theme="dark"]{
  --bg:#0a1615; --surface:#0f1f1e; --line:#1e302e; --line-soft:#182524;
  --ink-900:#eef3f2; --ink-700:#c4d1cf; --ink-500:#8fa19e; --ink-300:#5c6b69;
  --teal-100:#123634; --teal-50:#0f2726;
}
*{box-sizing:border-box;}
html,body{height:100%;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{
  margin:0; background:var(--bg); color:var(--ink-900);
  font-family:"Plus Jakarta Sans",-apple-system,BlinkMacSystemFont,sans-serif;
  -webkit-font-smoothing:antialiased;
}
.mono{font-family:"DM Mono",ui-monospace,monospace;}
button{font-family:inherit;}
img{max-width:100%;}
::selection{background:var(--teal-300);color:var(--teal-950);}

/* ---------- utility ---------- */
.hidden{display:none !important;}
.icon{width:18px;height:18px;flex:0 0 auto;display:block;}
.avatar{
  width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.78rem;color:#fff;flex:0 0 auto;
}
.badge{
  display:inline-flex;align-items:center;gap:6px;padding:3px 10px 3px 8px;border-radius:999px;
  font-size:.74rem;font-weight:600;white-space:nowrap;
}
.badge .dot{width:6px;height:6px;border-radius:50%;}
.badge.green{background:var(--green-bg);color:var(--green);}
.badge.green .dot{background:var(--green);}
.badge.red{background:var(--red-bg);color:var(--red);}
.badge.red .dot{background:var(--red);}
.badge.amber{background:var(--amber-bg);color:var(--amber);}
.badge.amber .dot{background:var(--amber);}
.badge.blue{background:var(--blue-bg);color:var(--blue);}
.badge.blue .dot{background:var(--blue);}

/* ================= LOGIN ================= */
#view-login{
  min-height:100vh; display:grid; grid-template-columns:1.05fr 1fr;
}
@media (max-width:860px){ #view-login{grid-template-columns:1fr;} .login-art{display:none;} }
.login-art{
  position:relative; overflow:hidden; color:#eafbf6;
  background:
    radial-gradient(1100px 620px at 15% 0%, rgba(95,205,189,.28), transparent 60%),
    radial-gradient(900px 700px at 90% 100%, rgba(20,80,78,.9), transparent 55%),
    linear-gradient(160deg, var(--teal-950), var(--teal-800) 65%, var(--teal-700));
  display:flex; flex-direction:column; justify-content:space-between; padding:56px 56px 44px;
}
.login-art::after{
  content:""; position:absolute; inset:0;
  background-image:
    radial-gradient(circle, rgba(255,255,255,.10) 1px, transparent 1.4px);
  background-size:26px 26px; opacity:.5; mix-blend-mode:overlay; pointer-events:none;
}
.brand{display:flex; align-items:center; gap:12px; position:relative; z-index:1;}
.brand-mark{
  width:42px;height:42px;border-radius:12px; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(145deg,var(--teal-300),var(--teal-500)); color:var(--teal-950);
}
.brand-name{font-weight:800; font-size:1.18rem; letter-spacing:-.01em;}
.brand-sub{font-size:.72rem; color:rgba(234,251,246,.65); font-weight:500;}
.login-art h1{
  font-size:2.5rem; line-height:1.12; font-weight:800; letter-spacing:-.02em; max-width:9.5ch;
  margin:0 0 18px; position:relative; z-index:1;
}
.login-art p{max-width:34ch; color:rgba(234,251,246,.78); font-size:1.02rem; line-height:1.6; position:relative; z-index:1;}
.art-figure{position:relative; z-index:1; display:flex; gap:14px; margin-top:38px;}
.art-chip{
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-md);
  padding:14px 16px; backdrop-filter:blur(6px); flex:1;
}
.art-chip b{display:block; font-size:1.3rem; font-weight:800;}
.art-chip span{font-size:.72rem; color:rgba(234,251,246,.65);}
.login-foot{position:relative; z-index:1; font-size:.75rem; color:rgba(234,251,246,.5);}

.login-form-wrap{display:flex; align-items:center; justify-content:center; padding:32px;}
.login-card{width:100%; max-width:380px;}
.login-card h2{font-size:1.5rem; font-weight:800; margin:0 0 6px; letter-spacing:-.01em;}
.login-card>p{margin:0 0 30px; color:var(--ink-500); font-size:.92rem;}
.field{margin-bottom:16px;}
.field label{display:block; font-size:.8rem; font-weight:600; color:var(--ink-700); margin-bottom:7px;}
.input-wrap{position:relative;}
.input-wrap input{
  width:100%; padding:12px 14px; border-radius:var(--radius-sm); border:1.5px solid var(--line);
  background:var(--surface); font-size:.94rem; color:var(--ink-900); outline:none;
  transition:border-color .15s;
}
.input-wrap input:focus{border-color:var(--teal-400); box-shadow:0 0 0 3px var(--teal-100);}
.input-wrap .toggle-eye{
  position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none;
  color:var(--ink-500); cursor:pointer; padding:4px;
}
.row-between{display:flex; align-items:center; justify-content:space-between; margin:2px 0 22px; font-size:.82rem;}
.check-line{display:flex; align-items:center; gap:8px; color:var(--ink-700);}
.check-line input{width:15px;height:15px; accent-color:var(--teal-500);}
.link{color:var(--teal-500); font-weight:600; text-decoration:none;}
.link:hover{text-decoration:underline;}
.btn{
  appearance:none; border:none; cursor:pointer; font-weight:700; border-radius:var(--radius-sm);
  font-size:.92rem; padding:12px 18px; display:inline-flex; align-items:center; justify-content:center; gap:8px;
  transition:transform .08s ease, filter .15s;
}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--teal-500); color:#fff; width:100%;}
.btn-primary:hover{filter:brightness(1.06);}
.btn-ghost{background:var(--surface); color:var(--ink-900); border:1.5px solid var(--line); width:100%;}
.btn-ghost:hover{border-color:var(--ink-300);}
.divider-or{display:flex; align-items:center; gap:14px; margin:18px 0; color:var(--ink-300); font-size:.78rem;}
.divider-or::before,.divider-or::after{content:""; flex:1; height:1px; background:var(--line);}

/* ================= APP SHELL ================= */
#view-app{min-height:100vh; display:grid; grid-template-columns:250px 1fr;}
@media (max-width:900px){ #view-app{grid-template-columns:1fr;} }

.sidebar{
  background:linear-gradient(190deg,var(--teal-950),var(--teal-900) 60%);
  color:#dff2ee; display:flex; flex-direction:column; padding:20px 14px; position:sticky; top:0; height:100vh;
  padding-top:calc(20px + env(safe-area-inset-top,0px));
}
@media (max-width:900px){
  .sidebar{
    position:fixed; inset:0; z-index:60; width:270px; height:100dvh; transform:translateX(-100%);
    transition:transform .25s ease; box-shadow:20px 0 40px rgba(0,0,0,.25);
  }
  .sidebar.open{transform:translateX(0);}
}
.side-brand{display:flex; align-items:center; gap:10px; padding:6px 10px 22px;}
.side-brand .brand-mark{width:34px;height:34px;border-radius:9px;}
.side-brand-name{font-weight:800; font-size:1rem; color:#fff;}
.side-brand-sub{font-size:.66rem; color:rgba(223,242,238,.55);}
.side-close{margin-left:auto; display:none; background:none; border:none; color:#dff2ee; cursor:pointer;}
@media (max-width:900px){.side-close{display:block;}}

.nav-group{display:flex; flex-direction:column; gap:2px; margin-bottom:6px;}
.nav-item{
  display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:var(--radius-sm);
  color:rgba(223,242,238,.78); text-decoration:none; font-size:.87rem; font-weight:600; cursor:pointer;
  border:none; background:none; width:100%; text-align:left;
}
.nav-item:hover{background:rgba(255,255,255,.06); color:#fff;}
.nav-item.active{background:var(--teal-400); color:var(--teal-950);}
.nav-spacer{flex:1;}
.nav-foot{border-top:1px solid rgba(255,255,255,.1); padding-top:10px; margin-top:8px;}

.main{min-width:0; display:flex; flex-direction:column;}
.topbar{
  position:sticky; top:0; z-index:40; background:var(--surface); border-bottom:1px solid var(--line);
  display:flex; align-items:center; gap:14px; padding:14px 26px;
  padding-top:calc(14px + env(safe-area-inset-top,0px));
}
.burger{display:none; background:none; border:none; cursor:pointer; color:var(--ink-700);}
@media (max-width:900px){.burger{display:block;}}
.search-wrap{
  flex:1; max-width:420px; display:flex; align-items:center; gap:9px; background:var(--bg);
  border:1px solid var(--line); border-radius:999px; padding:9px 14px; color:var(--ink-500);
}
.search-wrap input{border:none; outline:none; background:none; font-size:.86rem; width:100%; color:var(--ink-900);}
.topbar-spacer{flex:1;}
.icon-btn{
  position:relative; width:38px;height:38px; border-radius:50%; border:1px solid var(--line); background:var(--surface);
  display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--ink-700);
}
.icon-btn .ping{position:absolute; top:6px; right:7px; width:8px; height:8px; border-radius:50%; background:var(--red); border:2px solid var(--surface);}
.who{display:flex; align-items:center; gap:10px; padding-left:6px;}
.who-name{font-size:.84rem; font-weight:700; line-height:1.15;}
.who-role{font-size:.72rem; color:var(--ink-500);}

.content{padding:26px; flex:1;}
.page-head{margin-bottom:22px;}
.page-head h1{font-size:1.5rem; font-weight:800; margin:0 0 4px; letter-spacing:-.01em;}
.page-head p{margin:0; color:var(--ink-500); font-size:.9rem;}
.page-head-row{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;}

.card{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow-card);}
.card-pad{padding:20px 22px;}

/* KPI cards */
.kpi-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:20px;}
@media (max-width:1100px){.kpi-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:520px){.kpi-grid{grid-template-columns:1fr;}}
.kpi{padding:18px 20px; display:flex; flex-direction:column; gap:10px;}
.kpi-top{display:flex; align-items:center; justify-content:space-between;}
.kpi-icon{width:38px;height:38px;border-radius:11px; display:flex; align-items:center; justify-content:center;}
.kpi-label{font-size:.78rem; color:var(--ink-500); font-weight:600;}
.kpi-value{font-size:1.55rem; font-weight:800; letter-spacing:-.01em;}
.kpi-delta{font-size:.75rem; font-weight:700; display:inline-flex; align-items:center; gap:3px;}
.kpi-delta.up{color:var(--green);}
.kpi-delta.down{color:var(--red);}

.grid-2col{display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:16px; align-items:stretch;}
@media (max-width:1100px){.grid-2col{grid-template-columns:1fr;}}
.card-head{display:flex; align-items:center; justify-content:space-between; padding:18px 22px 4px;}
.card-head h3{margin:0; font-size:.98rem; font-weight:700;}
.select-mini{
  font-size:.78rem; border:1px solid var(--line); background:var(--bg); border-radius:999px; padding:6px 12px;
  color:var(--ink-700); font-weight:600;
}

.appt-row{display:flex; align-items:center; gap:14px; padding:12px 22px;}
.appt-row+.appt-row{border-top:1px solid var(--line-soft);}
.appt-time{font-size:.8rem; font-weight:700; color:var(--ink-700); width:44px;}
.appt-name{font-size:.87rem; font-weight:700;}
.appt-type{font-size:.76rem; color:var(--ink-500);}
.appt-status{margin-left:auto;}
.dots-btn{background:none; border:none; color:var(--ink-300); cursor:pointer; padding:4px;}

.bars{display:flex; align-items:flex-end; gap:10px; height:150px; padding:6px 22px 8px;}
.bar-col{flex:1; display:flex; flex-direction:column; align-items:center; gap:8px;}
.bar{width:100%; max-width:22px; border-radius:5px 5px 0 0; background:linear-gradient(180deg,var(--teal-400),var(--teal-500));}
.bar-day{font-size:.72rem; color:var(--ink-500); font-weight:600;}

.donut-wrap{display:flex; align-items:center; gap:16px; padding:8px 22px 20px;}
.donut{width:106px;height:106px;border-radius:50%; flex:0 0 auto;}
.legend{display:flex; flex-direction:column; gap:8px; font-size:.76rem;}
.legend-item{display:flex; align-items:center; gap:8px; color:var(--ink-700);}
.legend-item .sw{width:9px;height:9px;border-radius:2px;}
.legend-item b{margin-left:auto; color:var(--ink-900);}

/* Tables */
.table-wrap{overflow-x:auto;}
table{width:100%; border-collapse:collapse; font-size:.86rem; min-width:640px;}
thead th{
  text-align:left; padding:12px 22px; color:var(--ink-500); font-weight:600; font-size:.74rem;
  border-bottom:1px solid var(--line); white-space:nowrap;
}
tbody td{padding:13px 22px; border-bottom:1px solid var(--line-soft); vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
.cell-person{display:flex; align-items:center; gap:11px;}
.cell-person b{font-weight:700; font-size:.87rem;}
.cell-sub{font-size:.75rem; color:var(--ink-500);}
.pagination{display:flex; align-items:center; justify-content:space-between; padding:16px 22px; flex-wrap:wrap; gap:10px;}
.pagination .info{font-size:.78rem; color:var(--ink-500);}
.page-btns{display:flex; gap:5px;}
.page-btn{
  width:30px;height:30px; border-radius:8px; border:1px solid var(--line); background:var(--surface);
  color:var(--ink-700); font-size:.78rem; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center;
}
.page-btn.active{background:var(--teal-500); border-color:var(--teal-500); color:#fff;}

.toolbar{display:flex; gap:10px; align-items:center; margin-bottom:16px; flex-wrap:wrap;}
.input-search{
  flex:1; min-width:220px; display:flex; align-items:center; gap:9px; border:1px solid var(--line);
  background:var(--surface); border-radius:var(--radius-sm); padding:10px 14px; color:var(--ink-500);
}
.input-search input{border:none; outline:none; background:none; width:100%; font-size:.86rem; color:var(--ink-900);}
.select-box{border:1px solid var(--line); background:var(--surface); border-radius:var(--radius-sm); padding:10px 14px; font-size:.85rem; font-weight:600; color:var(--ink-700);}
.btn-new{background:var(--teal-500); color:#fff; border:none; border-radius:var(--radius-sm); padding:10px 18px; font-weight:700; font-size:.85rem; cursor:pointer; display:flex; align-items:center; gap:8px; white-space:nowrap;}

/* Agenda page */
.agenda-layout{display:grid; grid-template-columns:280px 1fr; gap:16px; align-items:start;}
@media (max-width:960px){.agenda-layout{grid-template-columns:1fr;}}
.mini-cal{padding:16px;}
.mini-cal-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; font-weight:700; font-size:.88rem;}
.mini-cal-head button{background:none;border:none;color:var(--ink-500);cursor:pointer;}
.mini-cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:4px; text-align:center;}
.mini-cal-grid .dow{font-size:.65rem; color:var(--ink-300); font-weight:700; padding-bottom:4px;}
.mini-cal-grid .day{font-size:.78rem; padding:6px 0; border-radius:8px; color:var(--ink-700); cursor:pointer;}
.mini-cal-grid .day.muted{color:var(--ink-300);}
.mini-cal-grid .day.selected{background:var(--teal-500); color:#fff; font-weight:700;}
.filter-card{padding:16px; margin-top:16px;}
.filter-card h4{margin:0 0 12px; font-size:.86rem; font-weight:700;}
.filter-field{margin-bottom:12px;}
.filter-field label{display:block; font-size:.76rem; color:var(--ink-500); font-weight:600; margin-bottom:6px;}
.tabs-row{display:flex; gap:6px; background:var(--bg); border:1px solid var(--line); border-radius:999px; padding:4px; width:max-content;}
.tab-btn{border:none; background:none; padding:7px 15px; border-radius:999px; font-size:.8rem; font-weight:700; color:var(--ink-500); cursor:pointer;}
.tab-btn.active{background:var(--surface); color:var(--teal-700); box-shadow:0 1px 3px rgba(0,0,0,.08);}

/* Patient detail */
.detail-head{display:flex; align-items:center; gap:16px; margin-bottom:18px; flex-wrap:wrap;}
.back-btn{display:flex; align-items:center; gap:6px; background:none; border:none; color:var(--ink-500); font-weight:700; font-size:.84rem; cursor:pointer; padding:8px 0;}
.pat-avatar{width:62px;height:62px;border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1.15rem; color:#fff;}
.pat-name{font-size:1.2rem; font-weight:800; margin:0;}
.pat-sub{font-size:.82rem; color:var(--ink-500);}
.detail-grid{display:grid; grid-template-columns:1.6fr 1fr; gap:16px; align-items:start;}
@media (max-width:960px){.detail-grid{grid-template-columns:1fr;}}
.info-row{display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--line-soft);}
.info-row:last-child{border-bottom:none;}
.info-row .ii{color:var(--teal-500); margin-top:2px;}
.info-row .lbl{font-size:.72rem; color:var(--ink-500); font-weight:600; margin-bottom:2px;}
.info-row .val{font-size:.88rem; font-weight:700;}
.stack-16{display:flex; flex-direction:column; gap:16px;}

/* Tipos de consulta */
.type-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:16px;}
.type-card{padding:18px;}
.type-card-top{display:flex; align-items:center; gap:12px; margin-bottom:14px;}
.type-swatch{width:36px;height:36px;border-radius:10px; flex:0 0 auto;}
.type-name{font-weight:700; font-size:.94rem;}
.type-meta{font-size:.76rem; color:var(--ink-500);}
.type-row{display:flex; align-items:center; justify-content:space-between; font-size:.82rem; padding:6px 0;}
.type-row span:first-child{color:var(--ink-500);}
.type-row b{font-weight:700;}
.type-foot{display:flex; align-items:center; justify-content:space-between; margin-top:12px; padding-top:12px; border-top:1px solid var(--line-soft);}

/* Horários */
.prof-card+.prof-card{border-top:1px solid var(--line-soft);}
.prof-card{display:flex; align-items:center; gap:16px; padding:18px 22px; flex-wrap:wrap;}
.prof-info{min-width:170px;}
.prof-name{font-weight:700; font-size:.9rem;}
.prof-role{font-size:.76rem; color:var(--ink-500);}
.hours-strip{display:flex; gap:8px; flex-wrap:wrap; flex:1;}
.hours-chip{font-size:.74rem; background:var(--teal-100); color:var(--teal-700); padding:6px 12px; border-radius:999px; font-weight:700; white-space:nowrap;}
.hours-chip.off{background:var(--line-soft); color:var(--ink-300);}

/* Clínica / Configurações */
.settings-shell{display:grid; grid-template-columns:220px 1fr; gap:20px; align-items:start;}
@media (max-width:860px){.settings-shell{grid-template-columns:1fr;}}
.settings-nav{display:flex; flex-direction:column; gap:2px;}
.settings-nav button{
  text-align:left; padding:10px 14px; border-radius:var(--radius-sm); border:none; background:none;
  font-size:.86rem; font-weight:600; color:var(--ink-700); cursor:pointer; display:flex; align-items:center; gap:10px;
}
.settings-nav button:hover{background:var(--line-soft);}
.settings-nav button.active{background:var(--teal-100); color:var(--teal-700);}
.form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
@media (max-width:600px){.form-grid{grid-template-columns:1fr;}}
.form-field label{display:block; font-size:.78rem; font-weight:600; color:var(--ink-700); margin-bottom:6px;}
.form-field input,.form-field select,.form-field textarea{
  width:100%; padding:10px 12px; border-radius:var(--radius-sm); border:1.5px solid var(--line);
  font-size:.86rem; background:var(--surface); color:var(--ink-900); font-family:inherit; outline:none;
}
.form-field input:focus,.form-field select:focus,.form-field textarea:focus{border-color:var(--teal-400); box-shadow:0 0 0 3px var(--teal-100);}
.settings-pane{display:none;}
.settings-pane.active{display:block;}
.switch-row{display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-bottom:1px solid var(--line-soft);}
.switch-row:last-child{border-bottom:none;}
.switch-row .lbl2{font-size:.87rem; font-weight:700;}
.switch-row .sub2{font-size:.78rem; color:var(--ink-500); margin-top:2px;}
.switch{position:relative; width:42px; height:24px; border-radius:999px; background:var(--line); flex:0 0 auto; cursor:pointer; transition:background .15s;}
.switch::after{content:""; position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background:#fff; transition:transform .15s; box-shadow:0 1px 3px rgba(0,0,0,.2);}
.switch.on{background:var(--teal-500);}
.switch.on::after{transform:translateX(18px);}
